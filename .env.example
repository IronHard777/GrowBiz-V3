# Chave Gemini (IA + Veo). No Vercel, defina as duas com o mesmo valor:
# - VITE_GEMINI_API_KEY  (obrigatória no BUILD — o front usa no browser)
# - GEMINI_API_KEY       (obrigatória em Runtime — download/extensão de vídeo)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

